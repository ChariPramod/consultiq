{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#f0fdfa",
    "primaryBorderColor": "#0d9488",
    "lineColor": "#64748b",
    "primaryTextColor": "#0f172a",
    "actorBkg": "#f0fdfa",
    "actorBorder": "#0d9488",
    "actorTextColor": "#0f172a",
    "noteBkgColor": "#f8fafc",
    "noteBorderColor": "#94a3b8",
    "noteTextColor": "#334155"
  },
  "flowchart": {
    "curve": "linear",
    "htmlLabels": true,
    "wrappingWidth": 280,
    "nodeSpacing": 40,
    "rankSpacing": 55,
    "padding": 18
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true,
    "width": 190,
    "actorMargin": 70,
    "messageFontSize": 15,
    "noteFontSize": 14
  }
}
