{
  "name": "consultiq",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate-local.mjs",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs",
    "doctor": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/doctor.mjs",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.mjs",
    "db:backup": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backup-workspace.mjs",
    "db:restore": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/restore-workspace.mjs",
    "verify:hosted": "node --env-file-if-exists=.env.local scripts/verify-hosted.mjs",
    "evaluate:retrieval": "node --experimental-strip-types scripts/evaluate-retrieval.mjs",
    "evaluate:gate": "node --experimental-strip-types scripts/evaluate-gate.mjs",
    "verify:workflow": "node --env-file-if-exists=.env.local scripts/verify-hosted-workflow.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@clerk/nextjs": "^7.9.4",
    "@libsql/client": "^0.18.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "langsmith": "0.10.2",
    "lucide-react": "1.31.0",
    "motion": "^13.4.0",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
