# Copy to .env.local; never commit secrets. No automatic development identity.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated verified Clerk user IDs; empty denies every user.
CONSULTIQ_ALLOWED_USER_IDS=
# Local use: file:.local-data/consultiq.db (create .local-data first)
# Vercel: libsql://YOUR-DATABASE.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
ANTHROPIC_API_KEY=
AI_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=consultiq
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
MAX_AI_RUNS_PER_DAY=30
